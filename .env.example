# EcoSort configuration. Copy to `.env` and edit; app.py loads it at startup
# with a stdlib parser (no python-dotenv needed). Environment variables already
# set in your shell always win over this file.

# --- AI vision: Google Gemini (optional) ----------------------------------
# Get a key from https://aistudio.google.com/apikey then either:
#   export GEMINI_API_KEY="..."      (shell)
#   GEMINI_API_KEY=...               (this file)
# With no key, POST /api/identify answers from the deterministic classifier and
# reports analysis_mode="offline_fallback" - it never invents AI labels.
GEMINI_API_KEY=
# Any vision-capable Gemini model. gemini-2.5-flash is retired (HTTP 404);
# this lite model answered correctly on a free-tier key while the 3.x/4.x
# premium flash models returned 503/429.
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard per-request timeout in seconds.
GEMINI_TIMEOUT_SECONDS=20

# --- Rate limiting (per client per 60 s window) ---------------------------
# 0 disables enforcement for a bucket; RATE_LIMIT_ENABLED=0 disables all.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_IDENTIFY_PER_MIN=20
# Extra guard on paid vision calls; when exhausted the scan still succeeds with
# an offline answer instead of failing.
RATE_LIMIT_AI_PER_MIN=8
RATE_LIMIT_GENERAL_PER_MIN=60
