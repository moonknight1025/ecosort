# EcoSort configuration. Copy to `.env` and edit; app.py loads it at startup
# with a stdlib parser (no python-dotenv needed). Existing environment
# variables always take precedence over this file.

# --- AI vision (optional) -------------------------------------------------
# Without a key the app uses the deterministic offline classifier and the UI
# says so. Nothing breaks, nothing is downloaded.
ECOSORT_AI_API_KEY=
# 0 disables vision even if a key is present.
ECOSORT_AI_ENABLED=1
# Any OpenAI-compatible chat/completions endpoint works.
ECOSORT_AI_BASE_URL=https://api.openai.com/v1
ECOSORT_AI_MODEL=gpt-4o-mini
ECOSORT_AI_TIMEOUT_SECONDS=10

# --- Rate limiting (per client per 60 s window) ---------------------------
# 0 disables enforcement for a bucket; RATE_LIMIT_ENABLED=0 disables all.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_IDENTIFY_PER_MIN=20
RATE_LIMIT_AI_PER_MIN=8
RATE_LIMIT_GENERAL_PER_MIN=60
